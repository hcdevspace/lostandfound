# Copy this to .env on your EC2 instance and fill in every value

# Django core
SECRET_KEY=replace-with-a-long-random-string
DEBUG=False
ALLOWED_HOSTS=your-ec2-public-ip,your-domain.com

# Database (RDS PostgreSQL)
DB_ENGINE=postgres
DB_NAME=lostandfound
DB_USER=lostandfound_user
DB_PASSWORD=replace-with-strong-password
DB_HOST=your-rds-endpoint.rds.amazonaws.com
DB_PORT=5432

# AWS S3 (media/image storage)
USE_S3=True
AWS_ACCESS_KEY_ID=your-iam-access-key
AWS_SECRET_ACCESS_KEY=your-iam-secret-key
AWS_STORAGE_BUCKET_NAME=your-s3-bucket-name
AWS_S3_REGION_NAME=us-east-1

# School verification code (students use this to register)
SCHOOL_VERIFICATION_CODE=your-school-code

# Email (Gmail SMTP)
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=your-gmail@gmail.com
EMAIL_HOST_PASSWORD=your-16-char-app-password
DEFAULT_FROM_EMAIL=Lost and Found <your-gmail@gmail.com>
